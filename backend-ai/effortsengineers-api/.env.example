# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/effortsengineers
# Or individual params if you prefer:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=user
# PGPASSWORD=password
# PGDATABASE=effortsengineers

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
