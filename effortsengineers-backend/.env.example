# Apply scripts/migrate_portal_accounts.sql to the existing PostgreSQL database first.
# Keep real values in an untracked .env file or your deployment's secret settings.
# Configured accounts are created/updated on successful sign-in; passwords are stored hashed.
# Production requires strong passwords and a random JWT_SECRET of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Allowed frontend URL(s) for CORS and origin validation (comma-separated if multiple):
FRONTEND_URL=http://localhost:3000

# Configure these in the backend host's environment; never expose the token to frontend code.
FORMSUBMIT_TOKEN=
EMAIL_NOTIFICATION_CC=
EMAIL_REPLY_TO=sales@effortsengineers.in

ADMIN_LOGIN_ID=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# =============================================================================
# Image Storage Persistence (Railway Volume or AWS S3)
# =============================================================================
# Railway container filesystems are ephemeral: files stored in ./images are lost
# on redeploy or restart. To persist uploaded product photos and RFQ attachments,
# configure EITHER Option 1 (Railway Volume) OR Option 2 (AWS S3 / S3-compatible).
#
# Option 1: Railway Volume (Recommended for Railway)
# Attach a persistent volume to the backend service in Railway (mount path: /data).
# Railway automatically defines RAILWAY_VOLUME_MOUNT_PATH=/data, or set:
IMAGE_UPLOAD_DIR=./images
RAILWAY_VOLUME_MOUNT_PATH=

# Option 2: S3 Object Storage (AWS S3 / Cloudflare R2 / MinIO)
# If S3 credentials are provided, uploads are automatically persisted to S3 and
# served across container redeployments even without a local volume attached.
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=uploads/images

TEST_LOGIN_ID=test
TEST_EMAIL=
TEST_PASSWORD=
