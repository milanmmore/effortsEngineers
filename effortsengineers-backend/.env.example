# Apply scripts/migrate_portal_accounts.sql to the existing PostgreSQL database first.
# Keep real values in an untracked .env file or your deployment's secret settings.
# Configured accounts are created/updated on successful sign-in; passwords are stored hashed.
# Production requires strong passwords and a random JWT_SECRET of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Configure these in the backend host's environment; never expose the token to frontend code.
FORMSUBMIT_TOKEN=
EMAIL_NOTIFICATION_CC=
EMAIL_REPLY_TO=sales@effortsengineers.in

ADMIN_LOGIN_ID=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Product and inquiry uploads are stored in this backend image directory by default.
IMAGE_UPLOAD_DIR=./images

TEST_LOGIN_ID=test
TEST_EMAIL=
TEST_PASSWORD=
