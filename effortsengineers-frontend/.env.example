# Frontend Environment Variables Template
# For Railway, set this to the backend's public origin (without /api) before building the frontend.
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=https://dev.effortsengineers.in
# Keep false for development and preview deployments; set true only for the public production site.
NEXT_PUBLIC_INDEX_SITE=false

