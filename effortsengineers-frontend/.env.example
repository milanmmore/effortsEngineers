# Frontend Environment Variables Template
# For Railway, set this to the backend's public origin (without /api) before building the frontend.
NEXT_PUBLIC_API_URL=http://localhost:5000
# Set this to the public site origin for each deployment; update it and rebuild when the domain changes.
NEXT_PUBLIC_SITE_URL=https://dev.effortsengineers.in
# Products remains indexable; this controls indexing for other routes.
NEXT_PUBLIC_INDEX_SITE=false

# Centralized Contact Configuration (Change here to update everywhere across the site)
NEXT_PUBLIC_WHATSAPP="+91 90960 01010"
NEXT_PUBLIC_PRIMARY_EMAIL="saurabh@effortsengineers.in"
NEXT_PUBLIC_SECONDARY_EMAIL="effortsengineers@gmail.com"
NEXT_PUBLIC_ADDRESS="Shop No. 10, Shirole Park, Vetal Baba Chowk, Senapati Bapat Rd, Shivajinagar, Pune, Maharashtra, India"
