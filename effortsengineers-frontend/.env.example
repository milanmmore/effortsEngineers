# Frontend Environment Variables Template
# Configure both API variables before building the frontend. The trusted list is comma-separated.
NEXT_PUBLIC_API_URL=http://localhost:5000
# Must exactly list the backend origin(s) permitted by this frontend deployment.
NEXT_PUBLIC_API_TRUSTED_ORIGINS=http://localhost:5000
# Set per Railway frontend service; these values are read during the build.
BASE_URL=https://dev.effortsengineers.in
ALLOW_INDEXING=false

# Centralized Contact Configuration (Change here to update everywhere across the site)
NEXT_PUBLIC_WHATSAPP="+91 90960 01010"
NEXT_PUBLIC_PRIMARY_EMAIL="sales@effortsengineers.in"
NEXT_PUBLIC_ADDRESS="Shop No. 10, Shirole Park, Vetal Baba Chowk, Senapati Bapat Rd, Shivajinagar, Pune, Maharashtra 411016, India"
# Configure the sales@ address to forward to the appropriate staff in your email provider.
# Optional: add only verified business hours and public profile URLs.
# NEXT_PUBLIC_BUSINESS_HOURS=
# NEXT_PUBLIC_LINKEDIN_URL=
# NEXT_PUBLIC_GOOGLE_BUSINESS_PROFILE_URL=
# NEXT_PUBLIC_B2B_LISTING_URLS= (comma-separated HTTPS URLs)
# NEXT_PUBLIC_SECONDARY_EMAIL= (optional internal notification CC; not shown publicly)
